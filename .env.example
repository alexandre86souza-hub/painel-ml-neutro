# Você NÃO precisa editar este arquivo.
# O "npm start" cria o .env sozinho na primeira vez, com uma ML_DB_KEY aleatória.
# Senha do painel, App ID e chave secreta do Mercado Livre são cadastrados NO PAINEL,
# na tela de primeiro acesso, e ficam no SQLite (a chave secreta vai cifrada).

# Chave que cifra os tokens no banco (32 bytes em hex). Gerada automaticamente.
# Perder esta chave = ter de reconectar as contas do Mercado Livre.
ML_DB_KEY=

# Portas locais. Se estiverem ocupadas, o npm start escolhe a próxima livre.
PORT=3100
PORTA_PUBLICA=3101
SCRAPER_PORTA=8100

ML_SITE=MLB
ML_DB_FILE=dados.sqlite

# ---- Avançado (deixe como está na aula) ----
# Túnel HTTPS: cloudflared (padrão, com localtunnel de reserva) | localtunnel | nenhum
TUNEL=cloudflared
# Domínio próprio já apontando para a PORTA_PUBLICA (ex.: túnel nomeado da Cloudflare).
# Preenchido, o túnel automático não é aberto e a URL deixa de mudar a cada reinício.
URL_PUBLICA=
# 0 = não abrir o navegador sozinho ao rodar npm start
ABRIR_NAVEGADOR=1
# 1 = o painel também abre pelo endereço público (celular, outro computador), com senha.
#     A senha só é criada no computador; o login online tem limite de tentativas.
# 0 = o endereço público só recebe o retorno do login do ML e as notificações.
PAINEL_ONLINE=1
